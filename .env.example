# === SENZA DOMINIO: usa sslip.io gratis (HTTPS vero, senza comprare dominio) ===
# Se IP VPS = 91.189.1.10 -> usa:
# STREAM_DOMAIN=stream.91-189-1-10.sslip.io
# PANEL_DOMAIN=panel.91-189-1-10.sslip.io
# (sostituisci i punti IP con trattini, tutto il resto uguale, Let's Encrypt funziona)
# Genera in automatico con: ./gen-env-ip.sh 91.189.1.10 tuamail@example.com
#
# === CON DOMINIO (consigliato per nascondere IP con Cloudflare): ===
# STREAM_DOMAIN=stream.tuodominio.com
# PANEL_DOMAIN=panel.tuodominio.com
STREAM_DOMAIN=stream.91-189-1-10.sslip.io
PANEL_DOMAIN=panel.91-189-1-10.sslip.io
ACME_EMAIL=tuamail@example.com

# === PANEL Caddy BasicAuth ===
# Genera hash con: docker run --rm caddy:2.9-alpine caddy hash-password
PANEL_USER=admin
PANEL_HASH=$2a$14$CAMBIAQUESTOHASHCONUNOHASHVERO

# === MediaFlow (mai esposto fuori, solo rete interna docker) ===
API_PASSWORD=CAMBIA_con_password_lunga_32caratteri_random
PORT=8888

# === Tuo IP di casa/ufficio per eventuale whitelist (opzionale) ===
# ADMIN_IP=1.2.3.4
